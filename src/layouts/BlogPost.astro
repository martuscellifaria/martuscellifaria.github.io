---
import StatusBar from "../components/StatusBar.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  pubDate?: Date;
  file?: string;
}
const { title, description, pubDate, file } = Astro.props;

// Fallback: derive from URL if parent didn't pass `file`.
const derived =
  Astro.url.pathname.replace(/^\/blog\/?/, "").replace(/\/$/, "") || "index";
const statusFile = file ?? `${derived}.md`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <StatusBar file={statusFile} />
    <SiteHeader name="ahoialex" tagline="Pseudo CEO of the pseudo company AhoiTools. Professional developer and open source enthusiast." />
    <main>
      <h1>{title}</h1>
      {description && <p class="post-description">{description}</p>}
      {pubDate && (
        <p style="color:var(--fg-dim);font-size:0.85rem;margin-top:-0.5rem">
          {pubDate.toISOString().slice(0, 10)}
        </p>
      )}
      <article><slot /></article>
      <p class="back-hint">
        <a href="/">:b#</a> <span>back to buffer list</span>
      </p>
    </main>
    <footer class="footer">
      <span class="mode">-- INSERT --</span>
      <span class="right">:wq</span>
    </footer>
  </body>
</html>
