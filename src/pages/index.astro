---
import StatusBar from "../components/StatusBar.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ahoialex ~ blog</title>
  </head>
  <body>
    <StatusBar file="index.md" />
    <SiteHeader name="ahoialex" tagline="Pseudo CEO of the pseudo company AhoiTools. Professional developer and open source enthusiast." />
    <main>
      <h2>Releases</h2>
      <ul class="post-list">
        {posts.map((p) => (
          <li>
            <span class="date">{p.data.pubDate.toISOString().slice(0, 10)}</span>
            <div>
              <a href={`/blog/${p.id}/`}>{p.data.title}</a>
              {p.data.description && (
                <span class="post-item-desc">— {p.data.description}</span>
              )}
            </div>
          </li>
        ))}
      </ul>
      <p style="color:var(--fg-dim);margin-top:2rem">
        <span class="cursor"></span>
      </p>
    </main>
    <footer class="footer">
      <span class="mode">-- NORMAL --</span>
      <span class="right">:q</span>
    </footer>
  </body>
</html>
